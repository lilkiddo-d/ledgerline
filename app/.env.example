# --- Network ---------------------------------------------------------------
# Leave empty for Robinhood Chain mainnet's public RPC. For a local fork: http://127.0.0.1:8711
NEXT_PUBLIC_RPC_URL=
# WalletConnect Cloud project id (optional; without it only injected wallets are offered)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Project token ($LEDG) ---------------------------------------------------
# Empty = every token feature (staking, discount tiers) is hidden. Set after setProjectToken().
NEXT_PUBLIC_PROJECT_TOKEN=

# --- Compliance ---------------------------------------------------------------
# Comma-separated ISO-3166 alpha-2 country codes to block (uses Vercel's geo header). Empty = off.
GEOBLOCK_COUNTRIES=

# --- Local development only -----------------------------------------------------
# Address used by the "Dev account" connector against an anvil fork started with
# --auto-impersonate. Never set this in production; it is ignored unless the RPC is localhost.
NEXT_PUBLIC_DEV_MOCK_ACCOUNT=
